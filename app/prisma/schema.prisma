datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum WorkOrderType {
  MONTAZA
  DEMONTAZA
  INTERVENCIJA
  PREMONTAZA
  OSTALO
}

enum Difficulty {
  OSNOVNA
  ZAHTEVNA
}

enum InstallerName {
  SIMON
  VITO
  SERGEJ
  GREGOR
  KLEMEN
  OSTALO
}

enum OptionType {
  DIN1
  DIN2
  DIN3
  DIN4
  DIN5
  ANI1
  ANI2
  ANI3
  ALL_CAN
  FMSCAN
  TACHO
}

enum WorkOrderStatus {
  COMPLETED
  SENT
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  fullName         String
  isActive         Boolean  @default(true)

  // granularne pravice, ki jih dodeljuje admin (canManageUsers)
  canManageUsers   Boolean  @default(false)
  canManageClients Boolean  @default(false)
  canViewAllOrders Boolean  @default(false)
  canExportData    Boolean  @default(false)
  canSendEmail     Boolean  @default(false)
  canEditOrders    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workOrders WorkOrder[] @relation("CreatedBy")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  address   String?
  contact   String?
  createdAt DateTime @default(now())

  workOrders WorkOrder[]
}

model WorkOrder {
  id           String          @id @default(cuid())
  ident        String          @unique
  orderDate    DateTime        @default(now())
  type         WorkOrderType
  difficulty   Difficulty

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  vehiclePlate String
  vehicleBrand String
  vehicleModel String
  vehicleYear  String

  imei     String
  imeiPrev String?

  comment      String?
  signatureUrl String?

  status WorkOrderStatus @default(COMPLETED)

  createdById String
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  installers WorkOrderInstaller[]
  options    WorkOrderOption[]
  photos     WorkOrderPhoto[]

  @@index([orderDate])
  @@index([clientId])
  @@index([vehiclePlate])
  @@index([imei])
}

model WorkOrderInstaller {
  id          String        @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  name        InstallerName
  otherText   String?

  @@index([workOrderId])
}

model WorkOrderOption {
  id          String     @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder  @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  optionType  OptionType
  comment     String?

  @@index([workOrderId])
  @@index([optionType])
}

model WorkOrderPhoto {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  fileUrl     String
  uploadedAt  DateTime  @default(now())

  @@index([workOrderId])
}

// pomozna tabela za atomarno generiranje ident-a (DDMMYYYY + zaporedna st. znotraj dneva)
model DailySequence {
  orderDate  DateTime @id
  lastNumber Int
}
