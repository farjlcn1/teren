# Skopiraj to datoteko v ".env" in izpolni prave vrednosti. ".env" se NE sme dodati v git.

# Geslo za PostgreSQL bazo (izberi mocno geslo)
POSTGRES_PASSWORD=

# Skrivnost za podpisovanje sej (dolg nakljucen niz, npr. generiran z: openssl rand -hex 32)
SESSION_SECRET=

# SMTP nastavitve za posiljanje e-poste (delovni nalogi -> mail)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Teren <teren@tvoja-domena.com>"

# Zacetni admin uporabnik, ustvarjen ob prvem zagonu (seed)
SEED_ADMIN_EMAIL=admin@tvoja-domena.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME="Admin"
