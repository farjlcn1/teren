# Kopiraj v .env in izpolni. .env vsebuje skrivnosti in ne sodi v git.

# Geslo lokalne testne baze (samo črke in številke, ker gre v DATABASE_URL).
# Generiraj z: openssl rand -hex 24
POSTGRES_PASSWORD=

# Ključ za podpis prijavnih piškotkov aplikacije teren. Generiraj z: openssl rand -base64 32
SESSION_SECRET=

# Javni naslov aplikacije
APP_URL=https://teren.farjolcn.com

# E-pošta prvega admin uporabnika (docker compose --profile seed run --rm teren-seed)
SEED_ADMIN_EMAIL=

# Žeton Cloudflare tunela (Zero Trust -> Networks -> Tunnels), potreben samo za --profile tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# SMTP za pošiljanje nalogov po e-pošti (prazno = pošiljanje izklopljeno)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Nivo logiranja API-ja za com.sledenje.teren (DEBUG gre samo v datoteko)
API_LOG_LEVEL=DEBUG
